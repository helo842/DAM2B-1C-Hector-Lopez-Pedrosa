<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permís normal: cal declarar-lo per poder fer peticions HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        A partir d'Android 13 (API 33) cal demanar permís en temps d'execució
        per poder mostrar notificacions. En versions anteriors no cal.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Permís normal que demana l'app de rellotge per acceptar
        AlarmClock.ACTION_SET_ALARM. Sense això, el botó "Alarma" petava
        amb una SecurityException (vist al Logcat).
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Contactes">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            TODO 7: la pantalla de detall. Només s'obre des de la nostra app,
            per això NO és exportable.
        -->
        <activity
            android:name=".ContacteDetallActivity"
            android:exported="false" />

    </application>

</manifest>
